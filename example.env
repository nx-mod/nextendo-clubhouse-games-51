# clubhouse-games-51: copy to ".env" and fill in real values. Never commit the real .env.

# NEX identity (access key recovered from a real CONNECT signature; NEX 4.4.0 confirmed by a live match)
CLUBHOUSE_ACCESS_KEY=8c3661ff
CLUBHOUSE_NEX_VERSION=40400

# Wire-shape knobs
CLUBHOUSE_STATION_SCHEME=prudps
CLUBHOUSE_SECURE_MINOR=0
CLUBHOUSE_LEGACY_PIA=0

# Network (NEXTENDO_HOST is the bare public IP the console dials)
NEXTENDO_HOST=127.0.0.1
AUTH_PORT=8460
SECURE_PORT=61001
NEXTENDO_PROXY_PROTOCOL=0
NNCS_NAT_FILE=/root/nextendo/data/nat_endpoints.txt

# TLS
CERT_FILE=cert.pem
KEY_FILE=key.pem

# Nextendo account integration
NEXTENDO_ACCOUNT_URL=http://127.0.0.1:1
NEXTENDO_REQUIRE_ACCOUNT=0
NEXTENDO_REQUIRE_SIGNED_TOKEN=0

# Clubhouse's client leaves a created session closed until a later call, so without this two
# searchers each host their own lobby and never match. Marks created sessions open + active.
NEXTENDO_OPEN_PARTICIPATION=1

# Monitoring (fail-closed without a token)
DASH_PORT=8096
DASH_TOKEN=change-me
NEXTENDO_SNI_HOST=g2035bb00-lp1.s.n.srv.nintendo.net

# Secrets
NEXTENDO_INTERNAL_KEY=
NEXTENDO_SECRET=
NEXTENDO_SECRET_FILE=
NEXTENDO_SECURE_PASSWORD=securepasswordplz1
